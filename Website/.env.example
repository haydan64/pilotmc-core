# Local listener and Backend connection.
PORT=3001
BACKEND_URL=http://127.0.0.1:3000
BACKEND_API_TOKEN=
BACKEND_CONFIG_TOKEN=
# Secrets stay local.
DISCORD_CLIENT_SECRET=
SESSION_SECRET=
# Optional host-specific files used by the central logo/favicon URL settings.
SITE_LOGO_PATH=
SITE_FAVICON_PATH=

# Branding, OAuth callback URL, application ID and guild ID are centralized.
# Legacy installations without BACKEND_CONFIG_TOKEN can still use SITE_NAME,
# SITE_SHORT_NAME, SITE_DESCRIPTION, PUBLIC_URL, DISCORD_CLIENT_ID,
# DISCORD_GUILD_ID and DISCORD_REDIRECT_URI in this file.

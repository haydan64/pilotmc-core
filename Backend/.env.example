# Backend owns configuration and connects directly to its database.
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSL=
# Alternatively: DATABASE_URL=
PORT=3000
BACKEND_API_TOKEN=
SOCKET_IO_CORS_ORIGIN=
# Distinct service read tokens, kept out of the configuration database/editor.
# Provision a token for discord, website, and every instance:<SERVER_KEY>.
CONFIG_SERVICE_TOKENS={"discord":"","website":"","instance:example":""}
# Optional one-time import path; defaults to Backend/config.initial.json.
# CONFIG_INITIAL_FILE=

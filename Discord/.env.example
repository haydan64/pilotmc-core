# Bootstrap connection and secrets. Deployment settings come from Backend.
BACKEND_URL=http://127.0.0.1:3000
BACKEND_API_TOKEN=
# Distinct read-only configuration token provisioned for the Discord service.
BACKEND_CONFIG_TOKEN=
DISCORD_TOKEN=

# Legacy standalone installations without BACKEND_CONFIG_TOKEN can still use
# botConfig.json, serverListings.json, DISCORD_CLIENT_ID and DISCORD_GUILD_ID.
